// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CharacteristicType {
  ORIGIN
  FUR_COLOR
  HEIGHT
  EYE_COLOR
  LIFE_SPAN
  TEMPERAMENT
  HEALTH_ISSUES
  AGE
  WEIGHT
  COLOR
  GENDER
}

model Admin {
  admin_id String @id @default(uuid())
  email    String @unique
  password String

  created_at DateTime @default(now())

  @@map("admins")
}

model User {
  user_id     String   @id @default(uuid())
  username    String   @unique
  email       String   @unique
  password    String
  photo       String?
  location    String?
  latitude    Float?
  longitude   Float?
  dob         DateTime?
  description String?
  isBanned    Boolean 
  push_token String?

  pets                      Pet[]
  messages                  Message[]
  preferences               UserPreference[]
  tutorAdoptionInteractions TutorAdoptionInteraction[]
  adoptedMatches            Match[]  @relation("match_adopter")

  currentAdoptions Adoption[] @relation("currentOwner")
  previousAdoptions Adoption[] @relation("previousOwner")

  eventAttendances EventAttendee[]
  createdEvents Event[]

  @@map("users")
}

model Pet {
  pet_id       String   @id @default(uuid())
  user_id      String
  name         String
  species_id   String
  breed_id     String?
  main_photo   String?
  gender       String?
  dob          DateTime?
  size         String?
  height       Float?
  weight       Float?
  energy       Int?
  description  String?
  forAdoption  Boolean

  owner      User     @relation(fields: [user_id], references: [user_id])
  species    Species  @relation(fields: [species_id], references: [species_id])
  breed      Breed?   @relation(fields: [breed_id], references: [breed_id])

  photos         PetPhoto[]
  interactions   Interaction[] @relation("petInteractions")
  targetInteractions Interaction[] @relation("targetInteractions")

  matches1 Match[] @relation("pet1")
  matches2 Match[] @relation("pet2")

  preferences PetPreference[]
  tutorAdoptionInteractions TutorAdoptionInteraction[]

  eventAttendances EventAttendee[]

  @@map("pets")
}

model Species {
  species_id String @id @default(uuid())
  name       String
  description String?

  breeds Breed[]
  pets   Pet[]

  @@map("species")
}

model Breed {
  breed_id   String @id @default(uuid())
  species_id String
  name       String
  description String?

  species Species @relation(fields: [species_id], references: [species_id])
  pets    Pet[]

  characteristics Characteristic[]

  @@unique([name, species_id])

  @@map("breeds")
}

model PetPhoto {
  photo_id String @id @default(uuid())
  pet_id   String
  photo_nr Int
  url      String

  pet Pet @relation(fields: [pet_id], references: [pet_id])

  @@map("pet_photos")
}

model Interaction {
  interaction_id String   @id @default(uuid())
  pet_id         String
  target_pet_id  String
  like_dislike   Boolean
  timestamp      DateTime @default(now())

  pet        Pet @relation("petInteractions", fields: [pet_id], references: [pet_id])
  target_pet Pet @relation("targetInteractions", fields: [target_pet_id], references: [pet_id])

  @@map("interactions")
}

model Match {
  match_id   String   @id @default(uuid())
  pet_1_id   String
  pet_2_id   String
  timestamp  DateTime @default(now())
  unmatched  Boolean  @default(false)
  unmatched_by String?
  unmatch_timestamp DateTime?

  is_adoption Boolean @default(false)

  // When an adoption conversation originates from a tutor without a pet,
  // we may store the initiating tutor here to keep adoption matches unique per tutor.
  adopter_id String?

  adopter User? @relation("match_adopter", fields: [adopter_id], references: [user_id])

  adoption_confirmed_by_owner Boolean @default(false)
  adoption_confirmed_by_adopter Boolean @default(false)

  pet1 Pet @relation("pet1", fields: [pet_1_id], references: [pet_id])
  pet2 Pet @relation("pet2", fields: [pet_2_id], references: [pet_id])

  messages Message[]

    // 🆕 relation
  adoption Adoption?

  @@map("matches")
}

model Adoption {
  adoption_id    String   @id @default(uuid())

  match_id       String   @unique
  current_owner  String
  previous_owner String

  timestamp      DateTime @default(now())

  // relations
  match          Match @relation(fields: [match_id], references: [match_id])
  currentUser    User  @relation("currentOwner", fields: [current_owner], references: [user_id])
  previousUser   User  @relation("previousOwner", fields: [previous_owner], references: [user_id])

  @@map("adoptions")
}

model Message {
  message_id String   @id @default(uuid())
  match_id   String
  sender_id  String
  timestamp  DateTime @default(now())
  content    String

  // 🆕 NEW
  read       Boolean  @default(false)

  match  Match @relation(fields: [match_id], references: [match_id])
  sender User  @relation(fields: [sender_id], references: [user_id])

  @@map("messages")
}

model Text {
  text_id       String @id @default(uuid())
  original_text String

  translations TranslatedText[]
  preferences  Preference[]

  @@map("texts")
}

model TranslatedText {
  text_id  String
  language String
  text     String

  textRef Text @relation(fields: [text_id], references: [text_id])

  @@id([text_id, language])
  @@map("translated_texts")
}

model Preference {
  preference_id String @id @default(uuid())
  text_id       String

  text Text @relation(fields: [text_id], references: [text_id])

  users UserPreference[]
  pets  PetPreference[]

  @@map("preferences")
}

model UserPreference {
  user_id       String
  preference_id String
  weight        Float @default(1.0)

  user       User       @relation(fields: [user_id], references: [user_id])
  preference Preference @relation(fields: [preference_id], references: [preference_id])

  @@id([user_id, preference_id])
  @@map("user_preferences")
}

model PetPreference {
  pet_id        String
  preference_id String
  weight        Float @default(1.0)

  pet        Pet        @relation(fields: [pet_id], references: [pet_id])
  preference Preference @relation(fields: [preference_id], references: [preference_id])

  @@id([pet_id, preference_id])
  @@map("pet_preferences")
}

model Characteristic {
  characteristic_id String @id @default(uuid())

  // 🔗 Relation
  breed_id String
  breed    Breed @relation(fields: [breed_id], references: [breed_id], onDelete: Cascade)

  // 🧠 Type of characteristic
  type CharacteristicType

  // 📊 Values
  lower_bound Float?
  upper_bound Float?
  exact_value Float?
  string_value String?

  created_at DateTime @default(now())

  @@map("characteristics")
}

model Event {
  event_id String @id @default(uuid())

  title       String
  description String?

  starts_at DateTime
  ends_at   DateTime?

  location  String
  latitude  Float
  longitude Float

  image String?

  max_attendees Int?
  attendee_count Int @default(0)

  cancelled Boolean @default(false)

  created_by String
  creator User @relation(fields: [created_by], references: [user_id])

  created_at DateTime @default(now())

  attendees EventAttendee[]

  @@map("events")
}

model EventAttendee {
  event_attendee_id String  @id @default(uuid())
  event_id String
  user_id  String
  pet_id   String?

  joined_at DateTime @default(now())

  event Event @relation(fields: [event_id], references: [event_id], onDelete: Cascade)

  user User @relation(fields: [user_id], references: [user_id])

  pet Pet? @relation(fields: [pet_id], references: [pet_id])

  @@unique([event_id, user_id, pet_id])

  @@map("event_attendees")
}

model TutorAdoptionInteraction {
  adoption_id   String   @id @default(uuid())
  tutor_id      String   // user_id do tutor
  pet_id        String   // pet_id do pet para adoção
  like_dislike  Boolean  // true = swipe right (interesse), false = swipe left (rejeição)
  timestamp     DateTime @default(now())

  tutor User @relation(fields: [tutor_id], references: [user_id])
  pet   Pet  @relation(fields: [pet_id], references: [pet_id])

  @@unique([tutor_id, pet_id]) // Evitar duplicatas - um tutor só pode ter uma ação por pet
  @@map("tutor_adoption_interactions")
}


